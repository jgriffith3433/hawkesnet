{
  "name": "hawkesnet",
  "version": "1.4.1",
  "private": true,
  "description": "Hawkes Net: multiplayer for web, Babylon and Unity WebGL games (net.hawkesgen.ai). The service, its relay and the SDK.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/hub.ts",
    "dev": "node tools/net-dev.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "build": "node tools/build.mjs",
    "load": "node tools/net-load.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}

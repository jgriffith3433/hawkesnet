[Unit]
Description=Hawkes Net (net.hawkesgen.ai): tickets, the room directory and the relay (src/hub.ts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hawkes
Group=hawkes
WorkingDirectory=/srv/hawkes/hawkesnet
EnvironmentFile=/etc/hawkes/net.env
ExecStart=/usr/bin/node /srv/hawkes/hawkesnet/src/hub.ts
Restart=always
RestartSec=2
# SIGTERM drains: no new tickets on this node, players move on, the last usage goes to Gen.
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=1048576
# Hardening: the service writes only its data folder.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/hawkes/net-data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
